@startuml er
!title ER-диаграмма PostgreSQL (по миграциям backend/migrations)

entity users {
  * id : UUID <<PK, default gen_random_uuid()>>
  --
  name : VARCHAR(100) NOT NULL (btrim <> '')
  email : VARCHAR(320) NOT NULL
  password_hash : TEXT NOT NULL
  timezone : TEXT NOT NULL DEFAULT 'Europe/Moscow'
  created_at / updated_at : TIMESTAMPTZ
}
note right of users
  уникальный индекс users_email_unique
  по lower(email)
end note

entity tasks {
  * id : UUID <<PK>>
  --
  user_id : UUID NOT NULL <<FK users.id ON DELETE CASCADE>>
  type : TEXT CHECK (meeting | task | reminder)
  title : TEXT NOT NULL (btrim <> '')
  date : DATE NULL
  time : TIME NULL
  status : TEXT DEFAULT 'active'
  google_event_id : TEXT NULL
  created_at : TIMESTAMPTZ
}
note bottom of tasks
  CHECK (time IS NULL OR date IS NOT NULL)
  CHECK status: active|completed,
  либо task+in_progress
  INDEX task_user_date_time_idx (user_id, date, time)
end note

entity task_embeddings {
  * task_id : UUID <<PK, FK tasks.id ON DELETE CASCADE>>
  --
  embedding : vector(384) NOT NULL CHECK (vector_norm > 0)
  model : TEXT NOT NULL
  model_version : TEXT NOT NULL
  created_at : TIMESTAMPTZ
}

entity google_integrations {
  * user_id : UUID <<PK, FK users.id ON DELETE CASCADE>>
  --
  refresh_token : TEXT NOT NULL (хранится открыто)
  access_token : TEXT DEFAULT ''
  token_expiry : TIMESTAMPTZ NULL
  calendar_id : TEXT DEFAULT 'primary'
  google_email : TEXT NULL
  created_at / updated_at
}

entity notifications {
  * id : UUID <<PK>>
  --
  user_id : UUID NOT NULL <<FK users.id CASCADE>>
  task_id : UUID NOT NULL <<FK tasks.id CASCADE>>
  kind : TEXT CHECK (task_due | reminder_due | meeting_start)
  title / message : TEXT NOT NULL
  due_at : TIMESTAMPTZ NOT NULL
  status : TEXT DEFAULT 'pending' CHECK (pending | delivered)
  send_attempted_at : TIMESTAMPTZ NULL
  email_sent_at : TIMESTAMPTZ NULL
  created_at : TIMESTAMPTZ
}
note bottom of notifications
  UNIQUE (task_id, kind, due_at)
  INDEX pending: (due_at) WHERE status='pending'
  INDEX user: (user_id, created_at) WHERE status='pending'
  INDEX retention: (created_at)
end note

users ||--o{ tasks : "user_id"
users ||--o| google_integrations : "user_id"
users ||--o{ notifications : "user_id"
tasks ||--o| task_embeddings : "task_id"
tasks ||--o{ notifications : "task_id"
@enduml
