          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `postman_${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('email', email);",
                  "pm.collectionVariables.set('password', 'SuperSecretPassword123!');",
                  "pm.collectionVariables.set('timezone', 'Europe/Moscow');"
