# make run экспортирует переменные из этого файла.
ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
CONFIG_PATH=config/local.yaml

DATABASE_URL=postgres://gorkycode:local_dev_only@localhost:5432/gorkycode?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s

AI_SERVICE_URL=http://localhost:8090
REDIS_URL=redis://localhost:6380/0
AUTH_SESSION_TTL=24h

MODEL_PATH=model/asr-model

# Напоминания: планировщик уведомлений.
REMINDER_SCAN_INTERVAL=30s
REMINDER_SYNC_INTERVAL=10m
REMINDER_CLAIM_TTL=2m
REMINDER_RETENTION=720h
REMINDER_HORIZON=168h
REMINDER_RECONCILE_LIMIT=500
REMINDER_BATCH_LIMIT=100
REMINDER_OFFSETS=72h,24h,3h,10m
REMINDER_MIN_ADVANCE_LEAD=5h

# Email-доставка напоминаний: письма выключены без SMTP_HOST и EMAIL_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_KINDS=reminder_due,task_due,meeting_start

# Google Calendar: без GOOGLE_CLIENT_ID и GOOGLE_CLIENT_SECRET интеграция выключена.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/integrations/google/callback
GOOGLE_FRONTEND_REDIRECT=http://localhost:8088/
GOOGLE_EVENT_DURATION=1h
