# Cloud.ru is the only LLM provider. Set the API key's Key Secret, not Key ID.
LLM_PROVIDER=cloudru
CLOUDRU_API_KEY=
# API_KEY is also accepted when CLOUDRU_API_KEY is absent.
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Проверенная для сценариев проекта модель; учитывайте стоимость вызовов.
CLOUDRU_MODEL=ai-sage/GigaChat3.5-432B-A28B-Reasoning
CLOUDRU_FORCE_IPV4=false
CLOUDRU_TIMEOUT_SECONDS=60
CLOUDRU_MAX_RETRIES=1
CLOUDRU_MAX_TOKENS=2500
JOB_TIMEOUT_SECONDS=150

# A separately selected guard model is required for model-generated write actions.
# Set an actual model ID available to your account; no implicit fallback is used.
SECURITY_GUARD_MODE=enforce
SECURITY_GUARD_MODEL=
SECURITY_GUARD_TIMEOUT_SECONDS=15
SECURITY_GUARD_MAX_TOKENS=256
SECURITY_GUARD_MAX_CONCURRENCY=4
SECURITY_JOB_MAX_BODY_BYTES=262144
SECURITY_RESPOND_MAX_BODY_BYTES=524288
SECURITY_USER_MAX_CHARS=8192
SECURITY_HISTORY_MESSAGE_MAX_CHARS=8192
SECURITY_CONTEXT_MAX_CHARS=32768

LOG_LEVEL=INFO
PORT=8090

# Pinned local CPU encoder. Download once with scripts/download_embedding_model.py.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL_PATH=models/multilingual-e5-small
EMBEDDING_NUM_THREADS=2
EMBEDDING_MAX_WORKERS=1
EMBEDDING_TIMEOUT_SECONDS=10
