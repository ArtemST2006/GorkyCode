# Cloud.ru is the only LLM provider. Set the API key's Key Secret, not Key ID.
LLM_PROVIDER=cloudru
CLOUDRU_API_KEY=
# API_KEY is also accepted when CLOUDRU_API_KEY is absent.
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=ai-sage/GigaChat3-10B-A1.8B
CLOUDRU_FORCE_IPV4=false
CLOUDRU_TIMEOUT_SECONDS=60
CLOUDRU_MAX_RETRIES=0
CLOUDRU_MAX_TOKENS=2500
JOB_TIMEOUT_SECONDS=150

LOG_LEVEL=INFO
PORT=8090

# Pinned local CPU encoder. Download once with scripts/download_embedding_model.py.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL_PATH=models/multilingual-e5-small
EMBEDDING_NUM_THREADS=2
EMBEDDING_MAX_WORKERS=1
EMBEDDING_TIMEOUT_SECONDS=10
