BACKEND_PORT=8080
NGINX_PUBLIC_PORT=8088
NGINX_AI_PORT=8091
POSTGRES_DB=gorkycode
POSTGRES_USER=gorkycode
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6380

# Векторный поиск: exact или hnsw; применяется после пересоздания backend.
SEMANTIC_SEARCH_MODE=exact
SEMANTIC_SEARCH_EF_SEARCH=100
SEMANTIC_SEARCH_MAX_SCAN_TUPLES=20000
SEMANTIC_SEARCH_CANDIDATES=100
SEMANTIC_SEARCH_EXACT_THRESHOLD=1500
SEMANTIC_SEARCH_ANN_TIMEOUT=500ms

# Google Calendar: без GOOGLE_CLIENT_ID и GOOGLE_CLIENT_SECRET интеграция выключена.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8088/api/v1/integrations/google/callback
GOOGLE_FRONTEND_REDIRECT=http://localhost:8088/
